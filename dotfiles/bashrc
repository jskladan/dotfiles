# Eternal bash history.
# ---------------------
# Read eternal history to memory
ETERNAL_HISTFILE=~/.bash_history_eternal
touch $ETERNAL_HISTFILE
history -r $ETERNAL_HISTFILE

# Create new histfile for the "session"
mkdir -p ~/.bash_history_sessions
export HISTFILE=~/.bash_history_sessions/$(date '+%Y%m%d_%H%M%S').$$
touch $HISTFILE

# ignore lines matching the previous history entry
#  +
# ignore lines which begin with a white space character
export HISTCONTROL=ignoreboth

# Drop all `set ...` commands from history. Something outside this config
# replays a shell-option snapshot (`set +o ...`, `set -o ...`) into interactive
# history once per session. This covers the bare command and every form with
# arguments. (HISTORY_FILTER below applies the same rule when merging.)
export HISTIGNORE='set:set *'

# Undocumented feature which sets the size to "unlimited".
# http://stackoverflow.com/questions/9457233/unlimited-bash-history
export HISTFILESIZE=
export HISTSIZE=

# Commands considered noise; not written to the eternal history.
HISTORY_FILTER='^(cd|cd \.\.|ls|ll|mc|pwd|fg|bg|exit|history|vim|vim \.)$|^git (fetch|pull|push|commit -am .|diff|status)$|^(python|python3|python runapp\.py|source \.bin.env.activate)$|^set( |$)'

# append the recently closed session to the eternal history on EXIT
function historymerge {
    grep -v -E "$HISTORY_FILTER" "$HISTFILE" >> "$ETERNAL_HISTFILE" 2>/dev/null
    rm -f "$HISTFILE"
}
trap historymerge EXIT
# Bash does not run the EXIT trap when it is killed by a signal, so closing a
# terminal (SIGHUP) used to leave the session file behind forever. Convert the
# common terminating signals into a normal `exit` so historymerge runs once.
trap 'exit 129' HUP
trap 'exit 143' TERM

# Safety net: a shell that dies without its EXIT trap (kill -9, crash) still
# leaves its session file behind. Once a day, merge and remove orphans older
# than a day. This runs in the background so it never delays the prompt; active
# shells keep their file's mtime fresh via `history -a` and are skipped.
_sweep_stamp=~/.bash_history_sessions/.last_sweep
_last=0
[[ -f $_sweep_stamp ]] && _last=$(<"$_sweep_stamp")
_last=${_last//[^0-9]/}
_now=${EPOCHSECONDS:-0}
if (( _now > 0 && _now - ${_last:-0} > 86400 )); then
    printf '%s\n' "$_now" > "$_sweep_stamp"
    (
        find ~/.bash_history_sessions -maxdepth 1 -type f -mtime +1 -print0 2>/dev/null |
        while IFS= read -r -d '' _f; do
            [[ "$_f" == "$HISTFILE" ]] && continue
            grep -v -E "$HISTORY_FILTER" "$_f" >> "$ETERNAL_HISTFILE" 2>/dev/null
            rm -f "$_f"
        done
    ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
fi

# Block-aware history search on Ctrl-R: pick a command and see the lines
# around it, so a whole block ("docker run postgres", then the follow-ups)
# stays in view. Prefix search (Up-arrow / history-search-backward) is
# untouched, and nothing is deduped or rewritten.
function __hist_fzf {
    local selected cmd tmp q="${READLINE_LINE:0:${READLINE_POINT:-0}}"
    tmp=$(mktemp "${TMPDIR:-/tmp}/hist.XXXXXX") || return
    # Search the in-memory history (eternal history read at startup + this
    # session), commands only. `{n}` is fzf's zero-based line index — always a
    # plain integer — so the preview never has to parse fields out of a line.
    history | awk '{sub(/^ *[0-9]+ +/, ""); print}' > "$tmp"

    # Ctrl-S toggles sorting. Track it ourselves so the status line can show
    # "sort: relevance" / "sort: newest first" instead of fzf's +S/-S.
    rm -f "$tmp.sortstate"
    cat > "$tmp.sorttoggle" <<EOF
if [ -e "$tmp.sortstate" ]; then rm -f "$tmp.sortstate"; else : > "$tmp.sortstate"; fi
EOF

    selected=$(
        fzf --tac --scheme=history --tiebreak=index --query="$q" \
            --height=80% --reverse --border \
            --color=bg+:#374145,fg+:#d3c6aa,hl:#dbbc7f,hl+:#e69875,pointer:#a7c080,marker:#a7c080,info:#859289,header:#9da9a0,border:#414b50,prompt:#a7c080 \
            --header='Enter: select · Esc: cancel · Ctrl-S: sort · Ctrl-/: preview' \
            --bind "ctrl-s:execute-silent(bash $tmp.sorttoggle)+toggle-sort" \
            --bind 'start:hide-header' \
            --bind 'f1:toggle-header' \
            --bind 'ctrl-/:toggle-preview' \
            --info-command "info=\${FZF_INFO:-}; base=\${info%[+-]S}; base=\${base% }; if [ -e \"$tmp.sortstate\" ]; then mode='newest first'; else mode='relevance'; fi; if [ -n \"\$base\" ]; then printf '%s · sort: %s · F1: help' \"\$base\" \"\$mode\"; else printf 'sort: %s · F1: help' \"\$mode\"; fi" \
            --preview "i=\$(({n}+1)); a=\$((i-10)); [ \$a -lt 1 ] && a=1; b=\$((i+10)); rel=\$((i-a+1)); sed -n \"\${a},\${b}p\" \"$tmp\" | if command -v bat >/dev/null 2>&1; then bat --style=plain --color=always --language=bash --paging=never --highlight-line \"\$rel\"; else cat; fi" \
            --preview-window='down:60%:wrap' < "$tmp"
    ) || { rm -f "$tmp" "$tmp".*; return; }
    rm -f "$tmp" "$tmp".*
    cmd=$selected
    READLINE_LINE=$cmd
    READLINE_POINT=${#cmd}
}

if [[ $- == *i* ]] && command -v fzf >/dev/null 2>&1; then
    bind -x '"\C-r": __hist_fzf'
fi

