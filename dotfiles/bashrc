# WARN: Keep the unset at the top of the file!
# There is some PROMPT_COMMAND magic later on, and not having this would fuck-up multiple
#   `source ~/.bashrc` executions in one session
unset PROMPT_COMMAND

# Make Ctrl-S usable in the terminal. By default it is XOFF software flow
# control, which freezes output until Ctrl-Q and never reaches fzf.
if [[ $- == *i* && -t 0 ]]; then
    stty -ixon 2>/dev/null
fi

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# Ignore /etc/hosts
export COMP_KNOWN_HOSTS_WITH_HOSTFILE=''


# Disable homebrew autoupdate on brew install
export HOMEBREW_NO_AUTO_UPDATE=1

# Load Homebrew on macOS. The old test was `[[ $OSTYPE != ^.arwin.* ]]`, which
# is a glob that is always true — so this block never ran as intended. These are
# the values `brew shellenv` sets on an Apple Silicon Mac, applied statically so
# we don't spawn `brew` on every shell start.
if [[ $OSTYPE == darwin* ]]; then
    export HOMEBREW_PREFIX="/opt/homebrew"
    export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
    export HOMEBREW_REPOSITORY="/opt/homebrew"

    case ":$PATH:" in
        *":/opt/homebrew/bin:"*) ;;
        *) export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH" ;;
    esac
    case ":$MANPATH:" in
        *":/opt/homebrew/share/man:"*) ;;
        *) export MANPATH="/opt/homebrew/share/man${MANPATH:+:$MANPATH}" ;;
    esac
    case ":$INFOPATH:" in
        *":/opt/homebrew/share/info:"*) ;;
        *) export INFOPATH="/opt/homebrew/share/info${INFOPATH:+:$INFOPATH}" ;;
    esac

fi

# bash-completion: brew install bash-completion@2 (macOS) or
# dnf install bash-completion (Fedora). /etc/bashrc may already have loaded it
# on Linux, hence the guard.
if [[ -z ${BASH_COMPLETION_VERSINFO-} ]]; then
    if [[ -r /opt/homebrew/etc/profile.d/bash_completion.sh ]]; then
        . /opt/homebrew/etc/profile.d/bash_completion.sh
    elif [[ -r /usr/share/bash-completion/bash_completion ]]; then
        . /usr/share/bash-completion/bash_completion
    fi
fi

# ADD ~/.local/bin to PATH
if [[ -d "${HOME}/.local/bin" ]]; then
    PATH=$PATH:~/.local/bin
fi

# PyENV — intentionally NOT initialized at shell startup.
# `eval "$(pyenv init -)"` ran `pyenv rehash` (a filesystem scan) and
# `eval "$(pyenv virtualenv-init -)"` on every new shell (~0.65s total).
# On this machine `pyenv global` is "system", no project pins .python-version,
# and python3 already resolves to /opt/homebrew/bin/python3. Use `uv` instead.
# To opt back in for a session:
#   export PYENV_ROOT="$HOME/.pyenv"
#   eval "$(pyenv init -)"; eval "$(pyenv virtualenv-init -)"
# (Note: the old PATH lines here were also broken — they put the literal text
#  `command -v pyenv >/dev/null ||` into PATH instead of setting it.)

# Add Go's bin dir without spawning `go env` on every shell.
case ":$PATH:" in
    *":${GOPATH:-$HOME/go}/bin:"*) ;;
    *) export PATH="$PATH:${GOPATH:-$HOME/go}/bin" ;;
esac

