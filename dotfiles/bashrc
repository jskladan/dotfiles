# WARN: Keep the unset at the top of the file!
# There is some PROMPT_COMMAND magic later on, and not having this would fuck-up multiple
#   `source ~/.bashrc` executions in one session
unset PROMPT_COMMAND

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# Ignore /etc/hosts
export COMP_KNOWN_HOSTS_WITH_HOSTFILE=''


# Disable homebrew autoupdate on brew install (cheap, applies on all OSes)
export HOMEBREW_NO_AUTO_UPDATE=1

# On Linux, pull in Homebrew's bash-completion + shellenv.
# NOTE: this used to be `[[ $OSTYPE != ^.arwin.* ]]`, which is a glob test that
# is always true, so the whole block (including `brew shellenv`, a subprocess)
# ran on macOS too.
if [[ $OSTYPE != darwin* ]]; then
    # Homebrew Bash-completion
    [[ -r "/opt/homebrew/etc/profile.d/bash_completion.sh" ]] && . "/opt/homebrew/etc/profile.d/bash_completion.sh"

    # Fix homebrew [https://github.com/orgs/Homebrew/discussions/446]
    [[ -r "/opt/homebrew/bin/brew" ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

    # Transcode video on HW
    # alias yt-dlp='yt-dlp -f "bestvideo[height<=1080]+bestaudio" --cookies-from-browser firefox -o "%(title)s.%(ext)s" --merge-output-format mp4 --postprocessor-args "-c:v hevc_videotoolbox -c:a aac"'
fi

# Ensure Homebrew is on PATH on macOS without spawning `brew shellenv`.
if [[ $OSTYPE == darwin* && ":$PATH:" != *":/opt/homebrew/bin:"* ]]; then
    export PATH="/opt/homebrew/bin:$PATH"
fi

# ADD ~/.local/bin to PATH
if [[ -d "${HOME}/.local/bin" ]]; then
    PATH=$PATH:~/.local/bin
fi

# PyENV — intentionally NOT initialized at shell startup.
# `eval "$(pyenv init -)"` ran `pyenv rehash` (a filesystem scan) and
# `eval "$(pyenv virtualenv-init -)"` on every new shell (~0.65s total).
# On this machine `pyenv global` is "system", no project pins .python-version,
# and python3 already resolves to /opt/homebrew/bin/python3. Use `uv` instead.
# To opt back in for a session:
#   export PYENV_ROOT="$HOME/.pyenv"
#   eval "$(pyenv init -)"; eval "$(pyenv virtualenv-init -)"
# (Note: the old PATH lines here were also broken — they put the literal text
#  `command -v pyenv >/dev/null ||` into PATH instead of setting it.)

# Add Go's bin dir without spawning `go env` on every shell.
case ":$PATH:" in
    *":${GOPATH:-$HOME/go}/bin:"*) ;;
    *) export PATH="$PATH:${GOPATH:-$HOME/go}/bin" ;;
esac

# Git
function parse_git_branch {
  git branch --no-color 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/(\1)/'
}

source ~/.bash_completion.d/git
source ~/.bash_completion.d/git_prompt
export GIT_PS1_SHOWDIRTYSTATE=true
export GIT_PS1_SHOWSTASHSTATE=true
export GIT_PS1_SHOWUNTRACKEDFILES=true

function pagurepr {
    remote="${2:-origin}"
    git fetch $remote pull/$1/head:pr_$1
    git checkout pr_$1
}

# Aliases
alias python=python3
alias pyformat='git diff --name-only HEAD | grep '\''\.py$'\'' | xargs -r sh -c '\''isort "$@" && black "$@"'\'' --'
alias ls='ls -F --color' # / at the end of dirs; colorized
alias ll='ls -lah'
# Lazy-load thefuck: `thefuck --alias` starts Python on every shell (~0.13s).
# The stub loads the real function on first use.
if command -v thefuck >/dev/null 2>&1; then
    fuck() { unset -f fuck; eval "$(thefuck --alias)"; fuck "$@"; }
fi

