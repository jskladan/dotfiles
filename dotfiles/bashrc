# Fast git prompt: one `git status` call instead of the ~8 subprocesses
# `__git_ps1` spawns (each costs ~35-50ms under the corporate EDR agent).
# Output matches `__git_ps1 "%s"` with GIT_PS1_SHOWDIRTYSTATE/STASHSTATE/
# UNTRACKEDFILES enabled: "<branch>[ *][+][$][%]".
function __git_ps1_colorized {
    local out head="" stash=0 w="" i="" u="" oid="" xy val
    out=$(git status --porcelain=v2 --branch --show-stash 2>/dev/null) || return

    while IFS= read -r line; do
        case "$line" in
            '# branch.head '*) head=${line#\# branch.head } ;;
            '# branch.oid '*)  oid=${line#\# branch.oid } ;;
            '# stash '*)       stash=${line#\# stash } ;;
            '?'*)              u='%' ;;
            '1 '*|'2 '*)
                xy=${line:2:2}
                [[ ${xy:0:1} != . ]] && i='+'
                [[ ${xy:1:1} != . ]] && w='*'
                ;;
            'u '*)             w='*'; i='+' ;;
        esac
    done <<< "$out"

    [ -z "$head" ] && return
    # Detached HEAD needs describe/tag logic — fall back to the original.
    if [ "$head" = "(detached)" ]; then
        val=$(__git_ps1 "%s")
    else
        [[ "$oid" = "(initial)" && -z "$i" ]] && i='#'
        local flags="${w}${i}"
        (( stash > 0 )) && flags+='$'
        flags+="$u"
        val="$head"
        [ -n "$flags" ] && val+=" $flags"
    fi

    read -ra val_arr <<<"$val" # "safe" way to split string without bash expansion

    # select variant based on the split-array's-length
    # 0 ~~ Not in git
    # 1 ~~ No flags
    # 2 ~~ Some flags
    case "${#val_arr[@]}" in
        1)
            echo -e "${C_PRE}${PROMPT_GIT_COLOR:-${PROMPT_COLOR}}${C_SUF}(${val})${C_RES} "
            ;;
        2)
            echo -e "${C_PRE}${C_YELLOW}${C_SUF}(${val})${C_RES} "
            ;;
        *)
            ;;
    esac
}

C_RED="38;5;196"
C_BLUE="38;5;39"
C_YELLOW="38;5;178"
C_GREEN="38;5;40"
C_GREY="38;5;247"

# the '\001 '\002 are a necessary workarund for PS1 & bash colors...
C_PRE=$'\001\e['
C_SUF=$'m\002'
C_RES="${C_PRE}0${C_SUF}"

[[ "$EUID" -ne 0 ]] && PROMPT_COLOR=$C_GREY || PROMPT_COLOR=$C_RED

PS1="${C_PRE}"'${PROMPT_COLOR}'"${C_SUF}"'[\u@\h'"${C_RES}"
PS1+=' '
PS1+="${C_PRE}"'${PROMPT_DIR_COLOR:-${PROMPT_COLOR}}'"${C_SUF}"'\w]'"${C_RES}"
PS1+='\n'
PS1+='$(__git_ps1_colorized)\$ '

export PS1


export PROMPT_COMMAND_BASE="${PROMPT_COMMAND}"
# Set terminal tab name (and keep it by forcing the 'echo -ne ..') at the end of the PROMPT_COMMAND
function tabset {
    unset PROMPT_COMMAND

    # echo $HOSTNAME --> server.my.domain
    # echo ${HOSTNAME%%.*} --> server
    local host="${HOSTNAME%%.*}"

    case $host in
        Josefs-MacBook-Pro)
            host="MacBook"
            ;;
        fedora-desktop)
            host="Desktop"
            ;;
        *)
            ;;
    esac

    local user=""
    if [[ "$EUID" -eq 0 ]]; then  user="ROOT@"; fi

    local text=""
    if [[ "$1" ]]; then text+="[${*}] "; fi

    local SET_TAB_TEXT='echo -ne "\033]0;'"${text}${user}${host}"'\007"'

    if [[ $PROMPT_COMMAND_BASE =~ .(;|; )$ ]]
    then
        export PROMPT_COMMAND="${PROMPT_COMMAND_BASE} ${SET_TAB_TEXT}; "
    else
        export PROMPT_COMMAND="${PROMPT_COMMAND_BASE}; ${SET_TAB_TEXT}; "
    fi
}

# Set the tab name
tabset

